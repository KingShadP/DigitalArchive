rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Pillar 1: Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Pillar 3: Primitive & Path Guards
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Blueprint: UserProfile
    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024)) &&
             (!('collectorTier' in data) || (data.collectorTier in ['initiate', 'patron', 'archivist', 'guardian'])) &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    // Validation Blueprint: SavedArtifact
    function isValidSavedArtifact(data, userId) {
      return data.userId is string && data.userId == userId && data.userId == request.auth.uid &&
             data.artifactId is string && data.artifactId.size() <= 64 &&
             data.title is string && data.title.size() <= 200 &&
             (!('artifactClass' in data) || (data.artifactClass is string && data.artifactClass.size() <= 64)) &&
             data.savedAt is timestamp;
    }

    // Validation Blueprint: FavoriteTrack
    function isValidFavoriteTrack(data, userId) {
      return data.userId is string && data.userId == userId && data.userId == request.auth.uid &&
             data.trackId is string && data.trackId.size() <= 64 &&
             data.releaseId is string && data.releaseId.size() <= 64 &&
             data.title is string && data.title.size() <= 200 &&
             (!('duration' in data) || (data.duration is string && data.duration.size() <= 32)) &&
             data.addedAt is timestamp;
    }

    // Validation Blueprint: Transmission
    function isValidTransmission(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.authorName is string && data.authorName.size() > 0 && data.authorName.size() <= 100 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 256 &&
             data.category in ['general', 'acquisition', 'curatorial', 'press', 'sound'] &&
             data.subject is string && data.subject.size() > 0 && data.subject.size() <= 200 &&
             data.message is string && data.message.size() > 0 && data.message.size() <= 2000 &&
             data.status in ['pending', 'reviewed', 'archived'] &&
             data.createdAt is timestamp;
    }

    // Validation Blueprint: GuestbookEntry
    function isValidGuestbookEntry(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.authorName is string && data.authorName.size() > 0 && data.authorName.size() <= 100 &&
             data.message is string && data.message.size() > 0 && data.message.size() <= 500 &&
             (!('location' in data) || (data.location is string && data.location.size() <= 100)) &&
             data.createdAt is timestamp;
    }

    // Collection: User Profiles
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false; // No blanket user listing

      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId &&
                      isValidUserProfile(incoming()) &&
                      incoming().createdAt == request.time &&
                      incoming().updatedAt == request.time;

      allow update: if isSignedIn() && isValidId(userId) && request.auth.uid == userId &&
                      isValidUserProfile(incoming()) &&
                      incoming().userId == existing().userId &&
                      incoming().createdAt == existing().createdAt &&
                      incoming().updatedAt == request.time &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'collectorTier', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

      // Subcollection: Saved Artifacts
      match /saved_artifacts/{artifactId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(artifactId) && request.auth.uid == userId;
        allow list: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

        allow create: if isSignedIn() && isValidId(userId) && isValidId(artifactId) && request.auth.uid == userId &&
                        isValidSavedArtifact(incoming(), userId) &&
                        incoming().savedAt == request.time;

        allow update: if false; // Saved items are atomic bookmarks

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(artifactId) && request.auth.uid == userId;
      }

      // Subcollection: Favorite Tracks
      match /favorite_tracks/{trackId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(trackId) && request.auth.uid == userId;
        allow list: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

        allow create: if isSignedIn() && isValidId(userId) && isValidId(trackId) && request.auth.uid == userId &&
                        isValidFavoriteTrack(incoming(), userId) &&
                        incoming().addedAt == request.time;

        allow update: if false; // Favorite track items are atomic

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(trackId) && request.auth.uid == userId;
      }
    }

    // Collection: Transmissions (Inquiries to KingShadP Studio)
    match /transmissions/{transmissionId} {
      allow get: if isSignedIn() && isValidId(transmissionId) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn() && isValidId(transmissionId) &&
                      isValidTransmission(incoming()) &&
                      incoming().status == 'pending' &&
                      incoming().createdAt == request.time;

      allow update: if false;
      allow delete: if false;
    }

    // Collection: Public Guestbook / Signal Logs
    match /guestbook/{entryId} {
      allow get, list: if true; // Public read for visitor signal impressions

      allow create: if isSignedIn() && isValidId(entryId) &&
                      isValidGuestbookEntry(incoming()) &&
                      incoming().createdAt == request.time;

      allow update: if false; // Immutable signal log
      allow delete: if false;
    }
  }
}
